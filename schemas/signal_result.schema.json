{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CE Signal Result",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "classification", "phase", "uncertainty_state", "evidence_packet_ref", "canon_input_valid", "provenance"],
  "properties": {
    "status": {"type": "string", "enum": ["VALID", "NOT_IMPLEMENTED", "NON_AUTHORIZED", "INVALID_INPUT", "CALCULATION_FAILURE"]},
    "classification": {"type": ["string", "null"]},
    "phase": {"type": ["string", "null"]},
    "uncertainty_state": {"type": ["string", "null"]},
    "evidence_packet_ref": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["evidence_packet_id", "content_sha256"],
      "properties": {
        "evidence_packet_id": {"type": "string", "minLength": 1},
        "content_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"}
      }
    },
    "canon_input_valid": {"type": "boolean"},
    "provenance": {"type": "object"}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "VALID"}}, "required": ["status"]},
      "then": {
        "required": ["classification", "phase", "uncertainty_state", "evidence_packet_ref"],
        "properties": {
          "classification": {"type": "string", "minLength": 1},
          "phase": {"type": "string", "minLength": 1},
          "uncertainty_state": {"type": "string", "minLength": 1},
          "evidence_packet_ref": {
            "type": "object",
            "additionalProperties": false,
            "required": ["evidence_packet_id", "content_sha256"],
            "properties": {
              "evidence_packet_id": {"type": "string", "minLength": 1},
              "content_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"}
            }
          },
          "canon_input_valid": {"const": true}
        }
      }
    },
    {
      "if": {"properties": {"status": {"enum": ["NOT_IMPLEMENTED", "NON_AUTHORIZED", "INVALID_INPUT", "CALCULATION_FAILURE"]}}, "required": ["status"]},
      "then": {
        "properties": {
          "classification": {"const": null},
          "phase": {"const": null},
          "uncertainty_state": {"const": null},
          "evidence_packet_ref": {"const": null},
          "canon_input_valid": {"const": false}
        }
      }
    }
  ]
}
