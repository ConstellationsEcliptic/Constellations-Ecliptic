{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CE Signal Result",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "classification", "phase", "uncertainty_state", "evidence_packet_ref", "canon_input_valid", "provenance"],
  "properties": {
    "status": {"type": "string", "enum": ["VALID", "NOT_IMPLEMENTED", "NON_AUTHORIZED", "INVALID_INPUT", "CALCULATION_FAILURE"]},
    "classification": {"type": ["string", "null"]},
    "phase": {"type": ["string", "null"]},
    "uncertainty_state": {"type": ["string", "null"]},
    "evidence_packet_ref": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["evidence_packet_id", "content_sha256"],
      "properties": {
        "evidence_packet_id": {"type": "string", "minLength": 1},
        "content_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"}
      }
    },
    "canon_input_valid": {"type": "boolean"},
    "provenance": {
      "type": "object",
      "additionalProperties": {"type": ["string", "number", "boolean", "null"]},
      "properties": {
        "source_commit": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
        "source_tree_sha256_v2": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
        "dependency_lock_digest": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
        "timezone_bundle_digest": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
        "ephemeris_bundle_digest": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
        "runtime_image_digest": {"type": "string", "pattern": "^sha256:[0-9a-fA-F]{64}$"},
        "calculation_version": {"type": "string", "minLength": 1}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "VALID"}}, "required": ["status"]},
      "then": {
        "required": ["classification", "phase", "uncertainty_state", "evidence_packet_ref"],
        "properties": {
          "classification": {"type": "string", "minLength": 1},
          "phase": {"type": "string", "minLength": 1},
          "uncertainty_state": {"type": "string", "minLength": 1},
          "evidence_packet_ref": {
            "type": "object",
            "additionalProperties": false,
            "required": ["evidence_packet_id", "content_sha256"],
            "properties": {
              "evidence_packet_id": {"type": "string", "minLength": 1},
              "content_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"}
            }
          },
          "canon_input_valid": {"const": true},
          "provenance": {
            "required": ["source_commit", "source_tree_sha256_v2", "dependency_lock_digest", "timezone_bundle_digest", "ephemeris_bundle_digest", "runtime_image_digest", "calculation_version"]
          }
        }
      }
    },
    {
      "if": {"properties": {"status": {"enum": ["NOT_IMPLEMENTED", "NON_AUTHORIZED", "INVALID_INPUT", "CALCULATION_FAILURE"]}}, "required": ["status"]},
      "then": {
        "properties": {
          "classification": {"const": null},
          "phase": {"const": null},
          "uncertainty_state": {"const": null},
          "evidence_packet_ref": {"const": null},
          "canon_input_valid": {"const": false},
          "provenance": {
            "allOf": [
              {"not": {"required": ["source_commit"]}},
              {"not": {"required": ["source_tree_sha256_v2"]}},
              {"not": {"required": ["dependency_lock_digest"]}},
              {"not": {"required": ["timezone_bundle_digest"]}},
              {"not": {"required": ["ephemeris_bundle_digest"]}},
              {"not": {"required": ["runtime_image_digest"]}},
              {"not": {"required": ["calculation_version"]}},
              {"not": {"required": ["runtime_authority"], "properties": {"runtime_authority": {"const": "AUTHORIZED"}}}}
            ]
          }
        }
      }
    }
  ]
}
