{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CE Calculation Result",
  "type": "object",
  "additionalProperties": false,
  "required": ["request_id", "status", "execution_profile_id", "scenario_state", "normalized_time", "object_states", "warnings", "errors", "provenance"],
  "properties": {
    "request_id": {"type": "string", "minLength": 1},
    "status": {"type": "string", "enum": ["VALID", "NOT_IMPLEMENTED", "NON_AUTHORIZED", "INVALID_INPUT", "CALCULATION_FAILURE"]},
    "execution_profile_id": {"type": "string", "const": "CE-CALC-V1-EP-001"},
    "scenario_state": {"type": "string", "enum": ["STABLE", "VARIABLE", "POSSIBLE", "ROBUST", "MIXED", "NONE"]},
    "normalized_time": {"type": ["string", "null"]},
    "object_states": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["object_id", "longitude_deg", "speed_deg_per_day", "status"],
        "properties": {
          "object_id": {"type": "string", "minLength": 1},
          "longitude_deg": {"type": ["number", "null"], "minimum": 0, "exclusiveMaximum": 360},
          "speed_deg_per_day": {"type": ["number", "null"]},
          "status": {"type": "string", "enum": ["VALID", "NOT_IMPLEMENTED", "NON_AUTHORIZED", "INVALID_INPUT", "CALCULATION_FAILURE"]}
        }
      }
    },
    "warnings": {"type": "array", "items": {"type": "string"}},
    "errors": {"type": "array", "items": {"type": "string"}},
    "provenance": {
      "type": "object",
      "additionalProperties": {"type": ["string", "number", "boolean", "null"]}
    }
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "VALID"}}, "required": ["status"]},
      "then": {
        "required": ["normalized_time", "object_states", "provenance"],
        "properties": {
          "normalized_time": {"type": "string", "minLength": 1},
          "object_states": {"minItems": 1},
          "errors": {"maxItems": 0},
          "scenario_state": {"not": {"const": "NONE"}},
          "provenance": {
            "required": ["source_commit", "source_tree_sha256_v2", "dependency_lock_digest", "timezone_bundle_digest", "ephemeris_bundle_digest", "runtime_image_digest", "calculation_version"]
          }
        }
      }
    }
  ]
}
