{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CE V1 Native Runtime Fixture Specification R1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "fixtures"
  ],
  "properties": {
    "fixtures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "fixture_id",
          "julian_day_ut",
          "objects"
        ],
        "properties": {
          "fixture_id": {
            "type": "string",
            "minLength": 1
          },
          "julian_day_ut": {
            "type": "number"
          },
          "objects": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "enum": [
                "SUN",
                "MOON",
                "MERCURY",
                "VENUS",
                "MARS",
                "JUPITER",
                "SATURN",
                "URANUS",
                "NEPTUNE",
                "PLUTO",
                "CHIRON",
                "TRUE_NODE",
                "MEAN_LILITH"
              ]
            }
          }
        }
      }
    }
  }
}
